[TEMPLATE]
APP_NAME="Starterkit"

APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000
# Di balik HTTPS/sub-path, sertakan skema dan prefix-nya, mis:
#   APP_URL=https://app.example.com/admin
# Prefix itu dipakai otomatis untuk route()/asset() dan dikirim ke Vue
# sebagai shared prop `basePath`.

APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=
# Cookie sesi otomatis Secure bila APP_URL memakai https://.
# Samakan dengan prefix APP_URL saat aplikasi dipasang di sub-path.
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=starterkit

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Laravel Reverb (WebSocket, opsional). APP_ID/KEY/SECRET diisi lewat
# `php artisan reverb:install`. Biarkan kosong bila aplikasi belum memakai
# realtime; tidak ada halaman yang membuka koneksi secara otomatis.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=

# Sisi server: dipakai PHP untuk mengirim event ke Reverb.
REVERB_HOST=localhost
REVERB_PORT=8081
REVERB_SERVER_PORT=8081
REVERB_SCHEME=http

# Sisi browser: ditanamkan ke bundle saat build, jadi butuh build ulang bila
# diubah.
VITE_REVERB_APP_KEY=${REVERB_APP_KEY}
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8081
VITE_REVERB_SCHEME=http

# Password akun superadmin saat `php artisan db:seed`.
# Di local boleh kosong (memakai "password"); di luar local wajib diisi
# dengan password yang kuat dan tidak boleh bernilai "password".
SEED_SUPERADMIN_PASSWORD=

# Origin lintas domain yang diizinkan untuk API (dipisah koma).
# Kosong = tidak ada origin lintas domain yang diizinkan.
CORS_ALLOWED_ORIGINS=

# --- SonarQube (opsional, dipakai SonarScanner) ---
# Isi bila menganalisis kode dengan SonarQube. Bisa juga diisi langsung lewat
# sonar.host.url / sonar.login pada sonar-project.properties.
SONAR_HOST_URL=
SONAR_TOKEN=

# Boost mengirim POST /_boost/browser-logs setiap ada console warning/error.
# Matikan (false) bila memakai server PHP single-threaded agar request tidak
# menumpuk dan menahan request lain.
BOOST_BROWSER_LOGS_WATCHER=true

# Passkeys (opsional, isi bila perlu override default).
# Biarkan kosong = memakai host/origin dari APP_URL dan secret dari APP_KEY.
# PASSKEYS_ALLOWED_ORIGINS boleh berisi beberapa origin dipisah koma.
PASSKEYS_RELYING_PARTY_ID=
PASSKEYS_ALLOWED_ORIGINS=
PASSKEYS_USER_HANDLE_SECRET=
