{
  "$schema": "https://www.schemastore.org/package.json",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "test:js": "vitest run",
    "lint": "eslint resources/js tests/js",
    "format": "prettier --write resources/js tests/js",
    "format:check": "prettier --check resources/js tests/js",
    "test:js:watch": "vitest",
    "coverage:js": "vitest run --coverage"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.5",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vitest/coverage-v8": "^5.1.1",
    "@vue/test-utils": "^2.6.0",
    "concurrently": "^10.0.7",
    "daisyui": "^5.8.1",
    "eslint": "^10.15.0",
    "eslint-plugin-tailwindcss": "^4.4.0",
    "eslint-plugin-vue": "^10.12.1",
    "fontaine": "^1.0.3",
    "globals": "^17.14.0",
    "happy-dom": "^21.0.4",
    "laravel-echo": "^2.6.3",
    "laravel-vite-plugin": "^3.2.1",
    "prettier": "^3.10.1",
    "pusher-js": "^8.6.0",
    "tailwindcss": "^4.3.5",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "optionalDependencies": {
    "@laravel/multiplex": "^0.4.5"
  },
  "dependencies": {
    "@inertiajs/vite": "3.0",
    "@inertiajs/vue3": "3.0",
    "lucide-vue-next": "^1.0.0",
    "vue": "^3.5.45"
  },
  "overrides": {
    "glob": ">=14.0.2",
    "minimatch": ">=11.0.1"
  }
}