includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    bootstrapFiles:
        - vendor/larastan/larastan/bootstrap.php
    level: 5
    paths:
        - app
        - config
        - database
        - routes
    excludePaths:
        - storage/*
        - bootstrap/cache/*
    treatPhpDocTypesAsCertain: true
